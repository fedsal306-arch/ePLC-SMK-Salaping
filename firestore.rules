rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /laporan_plc/{laporanId} {
      allow read, write: if true;
    }
    match /sekolah/{sekolahId} {
      allow read, write: if true;
    }
    match /staf/{stafId} {
      allow read, write: if true;
    }
  }
}
